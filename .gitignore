.venv/
__pycache__/
*.pyc

# Regenerated by the pipeline, so not tracked. scripts/run_all.py rebuilds
# all of it, and the cached weather in data/weather is committed so it works
# offline.
data/identify/*.csv
data/evaluate/*.csv
data/train/*.csv
data/experiments/*.csv
data/step06_demo_timer.csv
results/model.pkl
results/legacy/model.pkl

# results/statespace.json and results/fan_penalty.json are deliberately
# tracked: they are a few kilobytes each and scripts/advise.py needs them, so
# committing them means the tool works straight after a clone.

# Local agent/editor config, never published
.claude/
CLAUDE.md
AGENTS.md
